# ==============================================================================
# AEGIS IP INTELLIGENCE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & SYSTEM SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data

# Auto-sync Cron schedule: minute hour day-of-month month day-of-week (default: every 1 hour)
SYNC_CRON=0 */1 * * *
SYNC_ON_STARTUP=true

# Security key to authorize manual POST /sync requests
SYNC_API_KEY=aegis-secret-sync-key

# Optional: GitHub Personal Access Token to avoid GitHub API rate limits
GITHUB_TOKEN=


# ------------------------------------------------------------------------------
# 2. ANTI-PROXY / ANTI-VPN / FRAUD DETECTION APIS
# ------------------------------------------------------------------------------
# ProxyCheck.io (1,000 queries/day free) - https://proxycheck.io/
PROXYCHECK_KEY=

# VPNAPI.io (1,000 queries/day free) - https://vpnapi.io/
VPNAPI_KEY=

# IPHub.info (1,000 queries/day free) - https://iphub.info/
IPHUB_KEY=

# IPHunter.info (1,000 queries/day free) - https://www.iphunter.info/
IPHUNTER_KEY=

# GetIPIntel.net (500+ queries/day free) - https://getipintel.net/
GETIPINTEL_EMAIL=

# IPQualityScore.com (5,000 queries/month free) - https://www.ipqualityscore.com/
IPQUALITYSCORE_KEY=


# ------------------------------------------------------------------------------
# 3. GEOLOCATION & IP ENRICHMENT APIS
# ------------------------------------------------------------------------------
# IPInfo.io (50,000 requests/month free) - https://ipinfo.io/
IPINFO_TOKEN=

# IPGeolocation.io (1,000 requests/day free) - https://ipgeolocation.io/
IPGEOLOCATION_API_KEY=

# IPData.co (1,500 requests/day free) - https://ipdata.co/
IPDATA_API_KEY=

# IP2Location.io (30,000 requests/month free) - https://ip2location.io/
IP2LOCATION_API_KEY=

# AbstractAPI.com (20,000 requests/month free) - https://www.abstractapi.com/
ABSTRACTAPI_API_KEY=


# ------------------------------------------------------------------------------
# 4. THREAT INTELLIGENCE & PASSIVE DNS APIS
# ------------------------------------------------------------------------------
# VirusTotal.com (500 queries/day free) - https://www.virustotal.com/
VIRUSTOTAL_API_KEY=

# AbuseIPDB.com (1,000 checks/day free) - https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=
